<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SpotiKit.ViewModels"
             xmlns:s="using:SpotiKit.Services"
             xmlns:c="using:SpotiKit.Controls"
             x:Class="SpotiKit.Views.DevView"
             x:DataType="vm:DevViewModel">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <Border Classes="page">
            <StackPanel Spacing="18">

                <Grid ColumnDefinitions="*,Auto" Classes="rise" Margin="4,4,0,4">
                    <StackPanel Spacing="6">
                        <TextBlock Classes="h1" Text="Developer" />
                        <TextBlock Classes="body" MaxWidth="640" HorizontalAlignment="Left"
                                   Text="Make your own themes, extensions, custom apps and CSS snippets." />
                    </StackPanel>
                    <Button AutomationProperties.Name="Open the docs" Grid.Column="1" VerticalAlignment="Bottom"
                            Command="{Binding OpenDocsCommand}" Padding="18,12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <c:StrokeIcon Data="{StaticResource IconLink}" Width="16" Height="16" />
                            <TextBlock Text="Open the docs" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Grid Classes="rise-1" ColumnDefinitions="*,*" ColumnSpacing="16">

                    <StackPanel Grid.Column="0" Spacing="16">

                        <c:GlassCard>
                            <StackPanel Spacing="14">
                                <StackPanel Spacing="2">
                                    <TextBlock Classes="h2" Text="Start something new" />
                                    <TextBlock Classes="caption" TextWrapping="Wrap"
                                               Text="Creates a folder from a template and opens it." />
                                </StackPanel>

                                <StackPanel Spacing="6">
                                    <TextBox Classes="glass" Text="{Binding NewName}" PlaceholderText="Name, for example Ocean Glass"
                                             MaxLength="60" />
                                    <TextBlock Classes="caption" Text="{Binding NewId, StringFormat='Folder name: {0}'}" />
                                </StackPanel>

                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="TypeScript" FontWeight="SemiBold" FontSize="13" />
                                        <TextBlock Classes="caption" TextWrapping="Wrap"
                                                   Text="Write it in src/ with types; spotikit-kit builds it into dist/. Needs Node.js. Not for snippets." />
                                    </StackPanel>
                                    <c:LiquidToggle Grid.Column="1" VerticalAlignment="Center"
                                                    AutomationProperties.Name="TypeScript" IsChecked="{Binding IsTypeScript}" />
                                </Grid>

                                <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8">
                                    <Button Padding="14,9" Command="{Binding CreateCommand}" CommandParameter="{x:Static s:AddonKind.Theme}">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <c:StrokeIcon Data="{StaticResource IconPalette}" Width="14" Height="14" />
                                            <TextBlock Text="New theme" />
                                        </StackPanel>
                                    </Button>
                                    <Button Padding="14,9" Command="{Binding CreateCommand}" CommandParameter="{x:Static s:AddonKind.Extension}">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <c:StrokeIcon Data="{StaticResource IconBolt}" Width="14" Height="14" />
                                            <TextBlock Text="New extension" />
                                        </StackPanel>
                                    </Button>
                                    <Button Padding="14,9" Command="{Binding CreateCommand}" CommandParameter="{x:Static s:AddonKind.CustomApp}">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <c:StrokeIcon Data="{StaticResource IconPuzzle}" Width="14" Height="14" />
                                            <TextBlock Text="New custom app" />
                                        </StackPanel>
                                    </Button>
                                    <Button Padding="14,9" Command="{Binding CreateCommand}" CommandParameter="{x:Static s:AddonKind.Snippet}">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <c:StrokeIcon Data="{StaticResource IconCode}" Width="14" Height="14" />
                                            <TextBlock Text="New snippet" />
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>

                                <Border Classes="subcard" IsVisible="{Binding Message, Converter={x:Static ObjectConverters.IsNotNull}}">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                        <c:StatusIndicator Kind="{Binding MessageStatus}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Message}" TextWrapping="Wrap" FontSize="12.5" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </c:GlassCard>

                        <c:GlassCard>
                            <StackPanel Spacing="12">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                    <StackPanel Spacing="2">
                                        <TextBlock Classes="h2" Text="Live preview" />
                                        <TextBlock Classes="caption" TextWrapping="Wrap"
                                                   Text="Save a file in your project and Spotify shows it right away. Spotify restarts once for this." />
                                    </StackPanel>
                                    <c:LiquidToggle Grid.Column="1" VerticalAlignment="Center"
                                                    AutomationProperties.Name="Live preview" IsChecked="{Binding IsLivePreview}" />
                                </Grid>
                                <Border Classes="subcard" IsVisible="{Binding LiveStatus, Converter={x:Static ObjectConverters.IsNotNull}}">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                        <c:StatusIndicator Kind="Success" VerticalAlignment="Center" IsVisible="{Binding IsLivePreview}" />
                                        <c:StatusIndicator Kind="Neutral" VerticalAlignment="Center" IsVisible="{Binding !IsLivePreview}" />
                                        <TextBlock Grid.Column="1" Text="{Binding LiveStatus}" TextWrapping="Wrap" FontSize="12.5" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </c:GlassCard>

                        <c:GlassCard>
                            <StackPanel Spacing="14">
                                <StackPanel Spacing="2">
                                    <TextBlock Classes="h2" Text="Apply to Spotify" />
                                    <TextBlock Classes="caption" TextWrapping="Wrap"
                                               Text="Puts your projects into Spotify for good, including new images and fonts." />
                                </StackPanel>
                                <Button Theme="{StaticResource PrimaryButton}" Padding="18,11" HorizontalAlignment="Left"
                                        AutomationProperties.Name="Apply to Spotify" Command="{Binding ApplyCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <c:StrokeIcon Data="{StaticResource IconInstall}" Width="15" Height="15" Foreground="White" />
                                        <TextBlock Text="Apply to Spotify" />
                                    </StackPanel>
                                </Button>
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" IsVisible="{Binding !Install.IsIdle}">
                                    <c:StatusIndicator Kind="Busy" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Classes="caption" Text="{Binding Install.Detail}" TextWrapping="Wrap" />
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10"
                                      IsVisible="{Binding ApplyMessage, Converter={x:Static ObjectConverters.IsNotNull}}">
                                    <c:StatusIndicator Kind="{Binding ApplyStatus}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Classes="caption" Text="{Binding ApplyMessage}" TextWrapping="Wrap" />
                                </Grid>
                            </StackPanel>
                        </c:GlassCard>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="16">

                        <c:GlassCard>
                            <StackPanel DataContext="{Binding Addons}" x:DataType="vm:AddonsViewModel" Spacing="10">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <TextBlock Classes="h2" Text="Your projects" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Theme="{StaticResource IconButton}" Command="{Binding RefreshCommand}"
                                            c:GlassToolTip.Tip="Look again">
                                        <c:StrokeIcon Data="{StaticResource IconRefresh}" Width="14" Height="14" />
                                    </Button>
                                </Grid>
                                <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding Summary}" />
                                <ItemsControl ItemsSource="{Binding Items}" IsVisible="{Binding HasItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <TextBlock Classes="mono" Text="{Binding}" Margin="0,2" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ItemsControl ItemsSource="{Binding Skipped}" IsVisible="{Binding HasSkipped}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="0,2">
                                                <c:StatusIndicator Kind="Warning" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Classes="caption" TextWrapping="Wrap" Text="{Binding}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8" Margin="0,4,0,0">
                                    <Button Padding="12,7" Command="{Binding OpenThemesCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <c:StrokeIcon Data="{StaticResource IconFolder}" Width="13" Height="13" />
                                            <TextBlock Text="Themes" FontSize="12.5" />
                                        </StackPanel>
                                    </Button>
                                    <Button Padding="12,7" Command="{Binding OpenExtensionsCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <c:StrokeIcon Data="{StaticResource IconFolder}" Width="13" Height="13" />
                                            <TextBlock Text="Extensions" FontSize="12.5" />
                                        </StackPanel>
                                    </Button>
                                    <Button Padding="12,7" Command="{Binding OpenAppsCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <c:StrokeIcon Data="{StaticResource IconFolder}" Width="13" Height="13" />
                                            <TextBlock Text="Custom Apps" FontSize="12.5" />
                                        </StackPanel>
                                    </Button>
                                    <Button Padding="12,7" Command="{Binding OpenSnippetsCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <c:StrokeIcon Data="{StaticResource IconFolder}" Width="13" Height="13" />
                                            <TextBlock Text="Snippets" FontSize="12.5" />
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>
                            </StackPanel>
                        </c:GlassCard>

                        <c:GlassCard>
                            <StackPanel Spacing="12">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <StackPanel Spacing="2">
                                        <TextBlock Classes="h2" Text="Check your projects" />
                                        <TextBlock Classes="caption" TextWrapping="Wrap"
                                                   Text="Finds what would break in Spotify or in the Marketplace: the manifest, missing files, and Spotify class names that change with updates." />
                                    </StackPanel>
                                    <Button Grid.Column="1" Padding="14,9" VerticalAlignment="Top" Command="{Binding CheckCommand}"
                                            AutomationProperties.Name="Check projects">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <c:StrokeIcon Data="{StaticResource IconCheck}" Width="13" Height="13" />
                                            <TextBlock Text="Check" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" IsVisible="{Binding IsChecking}">
                                    <c:StatusIndicator Kind="Busy" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Classes="caption" Text="Checking…" />
                                </Grid>
                                <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding CheckSummary}"
                                           IsVisible="{Binding CheckSummary, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                <ItemsControl ItemsSource="{Binding CheckResults}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Spacing="8" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ProjectCheckView">
                                            <Border Classes="subcard">
                                                <StackPanel Spacing="6">
                                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                                        <c:StatusIndicator Kind="{Binding Status}" VerticalAlignment="Center" />
                                                        <StackPanel Grid.Column="1" Spacing="1">
                                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Classes="caption" Text="{Binding Summary}" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Grid>
                                                    <ItemsControl ItemsSource="{Binding Lines}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="x:String">
                                                                <TextBlock Classes="caption" Text="{Binding}" TextWrapping="Wrap" Margin="0,1" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </c:GlassCard>

                        <c:GlassCard Padding="22,10">
                            <StackPanel DataContext="{Binding DevTools}" x:DataType="vm:DevToolsViewModel">
                                <Grid Classes="setting-row" ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Spotify developer tools" FontWeight="SemiBold" FontSize="13" />
                                        <TextBlock Classes="caption" TextWrapping="Wrap"
                                                   Text="Adds Spotify's Develop menu and Ctrl+Shift+I. Stays on until you turn it off. Spotify restarts to apply it." />
                                    </StackPanel>
                                    <c:LiquidToggle Grid.Column="1" VerticalAlignment="Center"
                                                    AutomationProperties.Name="Spotify developer tools"
                                                    IsChecked="{Binding IsOn}" IsEnabled="{Binding CanChange}" />
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="0,0,0,12"
                                      IsVisible="{Binding HasHint}">
                                    <c:StatusIndicator Kind="Warning" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Classes="caption" TextWrapping="Wrap" Text="{Binding Hint}" />
                                </Grid>
                                <Border Classes="subcard" Margin="0,0,0,12"
                                        IsVisible="{Binding Message, Converter={x:Static ObjectConverters.IsNotNull}}">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                        <c:StatusIndicator Kind="{Binding MessageStatus}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Message}" TextWrapping="Wrap" FontSize="12.5" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </c:GlassCard>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
