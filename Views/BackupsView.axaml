<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SpotiKit.ViewModels"
             xmlns:c="using:SpotiKit.Controls"
             xmlns:sys="using:System"
             x:Class="SpotiKit.Views.BackupsView"
             x:DataType="vm:BackupsViewModel">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <Border Classes="page">
            <StackPanel Spacing="18">

                <Grid ColumnDefinitions="*,Auto" Classes="rise" Margin="4,4,0,4">
                    <StackPanel Spacing="6">
                        <TextBlock Classes="h1" Text="Backups" />
                        <TextBlock Classes="body" MaxWidth="600" HorizontalAlignment="Left"
                                   Text="Copies of Spotify's files, made before every change. Restore one to go back." />
                    </StackPanel>
                    <Button AutomationProperties.Name="Back up now" Grid.Column="1" VerticalAlignment="Bottom" Theme="{StaticResource PrimaryButton}"
                            Command="{Binding CreateCommand}" Padding="18,12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <c:StrokeIcon Data="{StaticResource IconBackup}" Width="16" Height="16" />
                            <TextBlock Text="Back up now" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Grid Classes="rise-1" ColumnDefinitions="*,*" ColumnSpacing="16">
                    <c:GlassCard Grid.Column="0" Classes="small">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                            <Border Classes="icon-tile" VerticalAlignment="Top">
                                <c:StrokeIcon Data="{StaticResource IconFolder}" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock Classes="stat" Text="{Binding Summary}" TextWrapping="Wrap" />
                                <TextBlock Classes="caption" Text="{Binding Breakdown}" TextWrapping="Wrap"
                                           IsVisible="{Binding !IsEmpty}" />
                                <TextBlock Classes="mono" Foreground="{StaticResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" Text="{Binding Location}" />
                                <Button HorizontalAlignment="Left" Padding="12,7" Margin="0,4,0,0"
                                        Command="{Binding OpenFolderCommand}" CommandParameter="{x:Null}">
                                    <TextBlock Text="Open folder" FontSize="12.5" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </c:GlassCard>

                    <c:GlassCard Grid.Column="1" Classes="small">
                        <StackPanel Spacing="12">
                            <StackPanel Spacing="2">
                                <TextBlock Classes="h2" Text="Keep the latest" />
                                <TextBlock Classes="caption" TextWrapping="Wrap"
                                           Text="Older ones are deleted automatically. The original of each Spotify version is always kept." />
                            </StackPanel>
                            <ListBox Classes="segments" ItemsSource="{Binding RetentionOptions}"
                                     SelectedItem="{Binding Retention}">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="6" />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="sys:Int32">
                                        <TextBlock Text="{Binding}" MinWidth="28" TextAlignment="Center" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </c:GlassCard>
                </Grid>

                <Border Classes="subcard rise-1" IsVisible="{Binding Message, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <c:StatusIndicator Kind="{Binding MessageStatus}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="12.5" />
                    </StackPanel>
                </Border>

                <Panel Classes="rise-2" IsVisible="{Binding IsEmpty}">
                    <c:GlassCard>
                        <StackPanel Spacing="6" HorizontalAlignment="Center" Margin="0,18">
                            <c:StrokeIcon Data="{StaticResource IconBackup}" Width="34" Height="34"
                                          Foreground="{StaticResource TextTertiaryBrush}" HorizontalAlignment="Center" />
                            <TextBlock Classes="h2" Text="No backups yet" HorizontalAlignment="Center" />
                            <TextBlock Classes="caption" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="380"
                                       Text="One is made automatically before the first install." />
                        </StackPanel>
                    </c:GlassCard>
                </Panel>

                <ItemsControl ItemsSource="{Binding Backups}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="12" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:BackupItemViewModel">
                            <Panel Classes="pop-in">
                                <c:GlassCard Classes="small" Padding="18,16" CornerRadius="16">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                                        <Border Classes="wobble" Width="42" Height="42" VerticalAlignment="Center">
                                            <Panel>
                                                <Border CornerRadius="12" Background="{DynamicResource AccentSoftBrush}"
                                                        BoxShadow="inset 0 1 0 0 #33FFFFFF, inset 0 0 0 1 #0FFFFFFF" />
                                                <c:StrokeIcon Data="{StaticResource IconBackup}" Foreground="{DynamicResource AccentBrush}" />
                                                <Border Classes="badge" Background="{StaticResource SuccessBrush}"
                                                        IsVisible="{Binding IsOriginal}">
                                                    <c:StrokeIcon Data="{StaticResource IconCheck}" Width="12" Height="12"
                                                                  StrokeThickness="2.6" Foreground="#E6101418" />
                                                </Border>
                                            </Panel>
                                        </Border>

                                        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                            <TextBlock FontSize="13.5" FontWeight="SemiBold">
                                                <Run Text="{Binding TitleText}" />
                                                <Run Text="{Binding VersionText}" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="Medium" />
                                            </TextBlock>
                                            <TextBlock Classes="caption">
                                                <Run Text="{Binding CreatedText}" />
                                                <Run Text=", " />
                                                <Run Text="{Binding SizeText}" />
                                                <Run Text=", " />
                                                <Run Text="{Binding KindText}" />
                                            </TextBlock>
                                            <TextBlock Classes="caption" TextWrapping="Wrap" Foreground="{StaticResource WarningBrush}"
                                                       Text="{Binding RestoreBlocker}" IsVisible="{Binding !CanRestore}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <Button Padding="14,9" IsEnabled="{Binding CanRestore}"
                                                    Command="{Binding $parent[ItemsControl].((vm:BackupsViewModel)DataContext).RestoreCommand}"
                                                    CommandParameter="{Binding}">
                                                <TextBlock Text="Restore" />
                                            </Button>
                                            <Button Theme="{StaticResource IconButton}" c:GlassToolTip.Tip="Show in folder"
                                                    Command="{Binding $parent[ItemsControl].((vm:BackupsViewModel)DataContext).OpenFolderCommand}"
                                                    CommandParameter="{Binding}">
                                                <c:StrokeIcon Data="{StaticResource IconFolder}" Width="15" Height="15" />
                                            </Button>
                                            <Button Theme="{StaticResource IconButton}" c:GlassToolTip.Tip="Delete backup"
                                                    Command="{Binding $parent[ItemsControl].((vm:BackupsViewModel)DataContext).DeleteCommand}"
                                                    CommandParameter="{Binding}">
                                                <c:StrokeIcon Data="{StaticResource IconTrash}" Width="15" Height="15" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </c:GlassCard>
                            </Panel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
