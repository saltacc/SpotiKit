<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="CharcoalColor">#0C0E13</Color>
    <Color x:Key="CharcoalRaisedColor">#151821</Color>
    <SolidColorBrush x:Key="CharcoalBrush" Color="{StaticResource CharcoalColor}" />
    <SolidColorBrush x:Key="CharcoalRaisedBrush" Color="{StaticResource CharcoalRaisedColor}" />

    <SolidColorBrush x:Key="AccentBrush" Color="#4C6FFF" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#294C6FFF" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F3F5FA" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A7AFC0" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#6B7386" />

    <SolidColorBrush x:Key="GlassFillBrush" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="GlassFillHoverBrush" Color="#17FFFFFF" />
    <SolidColorBrush x:Key="GlassFillPressedBrush" Color="#0AFFFFFF" />
    <SolidColorBrush x:Key="GlassStrongFillBrush" Color="#1A1D2A" Opacity="0.72" />
    <SolidColorBrush x:Key="InsetFillBrush" Color="#33000000" />
    <SolidColorBrush x:Key="DividerBrush" Color="#14FFFFFF" />

    <Color x:Key="SuccessColor">#3DDC97</Color>
    <Color x:Key="WarningColor">#FFB547</Color>
    <Color x:Key="ErrorColor">#FF5C7A</Color>
    <Color x:Key="NeutralColor">#7A8296</Color>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />
    <SolidColorBrush x:Key="NeutralBrush" Color="{StaticResource NeutralColor}" />

    <CornerRadius x:Key="RadiusLarge">20</CornerRadius>
    <CornerRadius x:Key="RadiusMedium">14</CornerRadius>
    <CornerRadius x:Key="RadiusControl">10</CornerRadius>
    <CornerRadius x:Key="RadiusSmall">6</CornerRadius>

    <BoxShadows x:Key="CardShadow">inset 0 1 0 0 #8CFFFFFF, inset 0 -1 0 0 #1FFFFFFF, inset 0 0 0 1 #0FFFFFFF, 0 8 22 0 #40000000</BoxShadows>
    <BoxShadows x:Key="CardShadowHover">inset 0 1 0 0 #A6FFFFFF, inset 0 -1 0 0 #2EFFFFFF, inset 0 0 0 1 #17FFFFFF, 0 14 30 0 #59000000</BoxShadows>
    <BoxShadows x:Key="PanelShadow">inset 0 1 0 0 #66FFFFFF, inset 0 -1 0 0 #14FFFFFF, inset 0 0 0 1 #0DFFFFFF, 0 8 22 0 #33000000</BoxShadows>
    <BoxShadows x:Key="ControlRimClear">inset 0 1 0 0 #00FFFFFF, inset 0 -1 0 0 #00FFFFFF, inset 0 0 0 1 #00FFFFFF, 0 2 6 0 #00000000</BoxShadows>
    <BoxShadows x:Key="ControlRim">inset 0 1 0 0 #66FFFFFF, inset 0 -1 0 0 #14FFFFFF, inset 0 0 0 1 #0FFFFFFF, 0 2 6 0 #26000000</BoxShadows>
    <BoxShadows x:Key="ControlRimHover">inset 0 1 0 0 #8CFFFFFF, inset 0 -1 0 0 #24FFFFFF, inset 0 0 0 1 #17FFFFFF, 0 4 12 0 #33000000</BoxShadows>
    <BoxShadows x:Key="InsetRim">inset 0 1 0 0 #40000000, inset 0 -1 0 0 #12FFFFFF, inset 0 0 0 1 #0AFFFFFF</BoxShadows>

    <SplineEasing x:Key="EaseOutQuint" X1="0.22" Y1="1" X2="0.36" Y2="1" />

    <StreamGeometry x:Key="IconHome">M4,10.5 L12,4 L20,10.5 L20,19 C20,19.6 19.6,20 19,20 L15,20 L15,14.5 L9,14.5 L9,20 L5,20 C4.4,20 4,19.6 4,19 Z</StreamGeometry>
